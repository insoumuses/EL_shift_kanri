/**
 * 指定日が、その月の最終営業日かどうかを判定する。
 */
function elShiftIsLastBusinessDay_(date) {
  const targetDateKey = elShiftDateKey_(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate()
  );

  const lastBusinessDay = elShiftGetLastBusinessDayOfMonth_(
    date.getFullYear(),
    date.getMonth() + 1
  );

  const lastBusinessDayKey = elShiftDateKey_(
    lastBusinessDay.getFullYear(),
    lastBusinessDay.getMonth() + 1,
    lastBusinessDay.getDate()
  );

  Logger.log(
    `LAST BUSINESS DAY CHECK: today=${targetDateKey}, lastBusinessDay=${lastBusinessDayKey}`
  );

  return targetDateKey === lastBusinessDayKey;
}

/**
 * 指定年月の最終営業日を取得する。
 */
function elShiftGetLastBusinessDayOfMonth_(year, month) {
  let date = new Date(year, month, 0);

  while (!elShiftIsBusinessDay_(date)) {
    date.setDate(date.getDate() - 1);
  }

  return date;
}

/**
 * 営業日判定。
 *
 * 営業日：
 * - 土曜ではない
 * - 日曜ではない
 * - 休日データ Sheet に登録されている日付ではない
 */
function elShiftIsBusinessDay_(date) {
  const day = date.getDay();

  // 0 = Sunday, 6 = Saturday
  if (day === 0 || day === 6) {
    return false;
  }

  if (elShiftIsHolidayFromSheet_(date)) {
    return false;
  }

  return true;
}

/**
 * 休日データ Sheet を参照して祝日・会社休日を判定する。
 *
 * 対応できる形式：
 * - 2026/07/20
 * - 2026-07-20
 * - Date型の日付セル
 *
 * Sheet内のどの列に日付があっても拾えるように、
 * 全セルを走査して日付らしい値を判定する。
 */
function elShiftIsHolidayFromSheet_(date) {
  const holidayDateSet = elShiftGetHolidayDateSet_();

  const dateKey = elShiftDateKey_(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate()
  );

  return !!holidayDateSet[dateKey];
}

/**
 * 休日データ Sheet から休日一覧を取得する。
 *
 * Sheet名：休日データ
 */
function elShiftGetHolidayDateSet_() {
  const spreadsheet = elShiftOpenSpreadsheet_(
    EL_SHIFT_CONFIG.settingSpreadsheetId ||
    EL_SHIFT_CONFIG.targetSpreadsheetId ||
    ''
  );

  const sheet = spreadsheet.getSheetByName('休日データ');

  if (!sheet) {
    throw new Error('Sheet not found: 休日データ');
  }

  const values = sheet.getDataRange().getValues();
  const result = {};

  values.forEach((row) => {
    row.forEach((cell) => {
      const dateKey = elShiftParseHolidayDateKey_(cell);

      if (dateKey) {
        result[dateKey] = true;
      }
    });
  });

  Logger.log(
    `HOLIDAY DATA LOADED: ${Object.keys(result).length} dates from 休日データ`
  );

  return result;
}

/**
 * 休日データ Sheet のセル値を yyyy-mm-dd に変換する。
 */
function elShiftParseHolidayDateKey_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) {
    return elShiftDateKey_(
      value.getFullYear(),
      value.getMonth() + 1,
      value.getDate()
    );
  }

  const text = elShiftDisplayText_(value);

  if (!text) return '';

  let match = text.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/);
  if (match) {
    return elShiftDateKey_(
      Number(match[1]),
      Number(match[2]),
      Number(match[3])
    );
  }

  match = text.match(/^(\d{4})年(\d{1,2})月(\d{1,2})日$/);
  if (match) {
    return elShiftDateKey_(
      Number(match[1]),
      Number(match[2]),
      Number(match[3])
    );
  }

  return '';
}

/**
 * ログ用日付表示。
 */
function elShiftFormatDateForLog_(date) {
  return elShiftDateKey_(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate()
  );
}

/**
 * 最終営業日の判定確認用。
 * 必要に応じて year / month を書き換えて実行してください。
 */
function debugLastBusinessDay() {
  const year = 2026;
  const month = 7;

  const date = elShiftGetLastBusinessDayOfMonth_(year, month);

  Logger.log(
    `${year}年${month}月の最終営業日: ` +
      elShiftDateKey_(
        date.getFullYear(),
        date.getMonth() + 1,
        date.getDate()
      )
  );
}
