/*************************************************
 * 最終営業日
 *************************************************/

/**
 * 指定日がその月の最終営業日か
 */
function isLastBusinessDay_(date = new Date()) {
  const lastBusinessDay = getLastBusinessDay_(
    date.getFullYear(),
    date.getMonth() + 1
  );

  const todayKey = dateKey_(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate()
  );

  const lastKey = dateKey_(
    lastBusinessDay.getFullYear(),
    lastBusinessDay.getMonth() + 1,
    lastBusinessDay.getDate()
  );

  Logger.log(
    `LAST BUSINESS DAY CHECK: today=${todayKey}, last=${lastKey}`
  );

  return todayKey === lastKey;
}


/**
 * 指定年月の最終営業日を取得
 */
function getLastBusinessDay_(year, month) {
  const holidays = getHolidaySet_();

  const date = new Date(year, month, 0);

  while (!isBusinessDay_(date, holidays)) {
    date.setDate(date.getDate() - 1);
  }

  return date;
}


/**
 * 土日・休日データを除外
 */
function isBusinessDay_(date, holidays) {
  const day = date.getDay();

  // 日曜 / 土曜
  if (day === 0 || day === 6) {
    return false;
  }

  return !holidays.has(
    dateKey_(
      date.getFullYear(),
      date.getMonth() + 1,
      date.getDate()
    )
  );
}


/*************************************************
 * 休日データ
 *************************************************/

/**
 * 「休日データ」Sheetから休日一覧を取得
 */
function getHolidaySet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheet = ss.getSheetByName('休日データ');

  if (!sheet) {
    throw new Error('シートが見つかりません: 休日データ');
  }

  const values = sheet.getDataRange().getValues();
  const holidays = new Set();

  values.flat().forEach(value => {
    const key = parseHolidayDate_(value);

    if (key) {
      holidays.add(key);
    }
  });

  Logger.log(
    `HOLIDAY DATA: ${holidays.size}件`
  );

  return holidays;
}


/**
 * 休日データ → YYYY-MM-DD
 *
 * 対応：
 * Date
 * 2026/08/11
 * 2026-08-11
 * 2026年8月11日
 */
function parseHolidayDate_(value) {
  if (
    value instanceof Date &&
    !isNaN(value.getTime())
  ) {
    return dateKey_(
      value.getFullYear(),
      value.getMonth() + 1,
      value.getDate()
    );
  }

  const text = String(value || '')
    .normalize('NFKC')
    .trim();

  if (!text) {
    return '';
  }

  const match = text.match(
    /^(\d{4})(?:[/-]|年)(\d{1,2})(?:[/-]|月)(\d{1,2})日?$/
  );

  if (!match) {
    return '';
  }

  return dateKey_(
    Number(match[1]),
    Number(match[2]),
    Number(match[3])
  );
}


/*************************************************
 * Debug
 *************************************************/

function debugLastBusinessDay() {
  const year = 2026;
  const month = 8;

  const date = getLastBusinessDay_(year, month);

  Logger.log(
    `${year}年${month}月の最終営業日: ` +
    dateKey_(
      date.getFullYear(),
      date.getMonth() + 1,
      date.getDate()
    )
  );
}
