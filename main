const EL_SHIFT_CONFIG = {
  // DRY_RUN / TEST_ONE / EXECUTE
  mode: 'TEST_ONE',

  testCwId: '',
  testDate: '',

  autoTargetMonth: false,
  targetYear: 2026,
  targetMonth: 8,

  autoTargetMonthOffset: 1,

  targetSpreadsheetId: '',
  sourceSpreadsheetId: '1upjFhFqjJw8OE-WXxZhgfnHf8co5Amns12Tz-wDc4WU',
  memberDataSpreadsheetId: '',

  targetSheetName: '202608',
  sourceSheetName: '2026年8月',
  memberDataSheetName: 'メンバーデータ',

  // 列
  targetMemberColumn: 1,       // EL A列
  sourceMemberNameColumn: 4,   // 海外 D列
  memberNameColumn: 2,         // メンバーデータ B列
  memberCwIdColumn: 5,         // メンバーデータ E列
};

const WORKING_STATUS = new Set([
  'A',
  'R',
  '入社',

  '前',
  '前R',

  '後',
  '後R',

  '大',
  '前大',
  '後大',

  'CX部',
  'TL',
  'STL',
]);

const OFF_STATUS = new Set([
  '有',
  '特',
  '代',
  '公休',
  '健',
  'ワ',

  'E',
  '前E',
  '後E',
]);


const WRITABLE_VALUES = new Set([
  '',
  '休',
  '前',
  '後',
]);

const MS_VALUES = new Set([
  'M',
  'S',
]);


// ==========================================
// Main
// ==========================================

function runElShiftSync() {
  applyTargetMonth_();

  const cfg = EL_SHIFT_CONFIG;

  const targetSheet = getSheet_(
    openSpreadsheet_(cfg.targetSpreadsheetId),
    cfg.targetSheetName
  );

  const sourceSheet = getSheet_(
    openSpreadsheet_(cfg.sourceSpreadsheetId),
    cfg.sourceSheetName
  );

  const memberSheet = getSheet_(
    openSpreadsheet_(
      cfg.memberDataSpreadsheetId ||
      cfg.sourceSpreadsheetId
    ),
    cfg.memberDataSheetName
  );

  const target = targetSheet.getDataRange().getDisplayValues();
  const targetFormulas = targetSheet.getDataRange().getFormulas();
  const source = sourceSheet.getDataRange().getDisplayValues();

  // CW_ID → 海外姓名
  const memberMap = buildMemberMap_(memberSheet);

  // 海外姓名 → 行番号
  const sourceNameMap = buildNameRowMap_(
    source,
    cfg.sourceMemberNameColumn
  );

  // 日付 → 列番号
  const targetDates = detectDateColumns_(
    target,
    cfg.targetMemberColumn + 1,
    'EL'
  );

  const sourceDates = detectDateColumns_(
    source,
    cfg.sourceMemberNameColumn + 1,
    '海外'
  );

  const dates = getTargetDates_()
    .filter(shouldProcessDate_)
    .map(date => ({
      date,
      targetCol: targetDates[date],
      sourceCol: sourceDates[date],
    }))
    .filter(x => x.targetCol && x.sourceCol);

  if (!dates.length) {
    throw new Error('EL表と海外表で共通の日付列が見つかりません。');
  }

  const updates = {
    '': [],
    '休': [],
    '前': [],
    '後': [],
  };

  const summary = {
    targetMembers: 0,
    updatedMembers: 0,
    changedCells: 0,
    msProtected: 0,
    manualProtected: 0,
    unknownStatus: 0,
    skippedMembers: 0,
  };


  for (let i = 0; i < target.length; i++) {
    const row = i + 1;

    const cwId =
      extractCwId_(
        target[i][cfg.targetMemberColumn - 1]
      ) ||
      extractCwId_(
        targetFormulas[i][cfg.targetMemberColumn - 1]
      );

    if (!cwId) continue;
    if (!shouldProcessMember_(cwId)) continue;

    summary.targetMembers++;

    const overseasName = memberMap[cwId];

    if (!overseasName) {
      Logger.log(`SKIP: CW_ID未登録 ${cwId}`);
      summary.skippedMembers++;
      continue;
    }

    const sourceRow =
      sourceNameMap[normalize_(overseasName)];

    if (!sourceRow) {
      Logger.log(
        `SKIP: 海外表に姓名なし ${overseasName}`
      );
      summary.skippedMembers++;
      continue;
    }

    let changed = false;

    for (const d of dates) {
      const current = clean_(
        target[i][d.targetCol - 1]
      );

      const overseasStatus = clean_(
        source[sourceRow - 1][d.sourceCol - 1]
      );

      const next = convertStatus_(overseasStatus);

      if (next === null) {
        Logger.log(
          `UNKNOWN: ${overseasName}` +
          ` / ${d.date}` +
          ` / ${overseasStatus}`
        );

        summary.unknownStatus++;
        continue;
      }


      if (MS_VALUES.has(current)) {
        if (next !== '休') {
          summary.msProtected++;
          continue;
        }
      }


      else if (!WRITABLE_VALUES.has(current)) {
        summary.manualProtected++;
        continue;
      }


      if (current === next) {
        continue;
      }


      const address =
        columnLetter_(d.targetCol) + row;

      updates[next].push(address);

      Logger.log(
        `${overseasName}` +
        ` / ${d.date}` +
        ` / 海外=${overseasStatus || '(空白)'}` +
        ` / EL=${current || '(空白)'}` +
        ` → ${next || '(空白)'}`
      );

      summary.changedCells++;
      changed = true;
    }


    if (changed) {
      summary.updatedMembers++;
    }
  }


  if (cfg.mode !== 'DRY_RUN') {
    Object.entries(updates).forEach(
      ([value, cells]) => {
        if (!cells.length) return;

        targetSheet
          .getRangeList(cells)
          .setValue(value);
      }
    );
  }


  Logger.log(
    [
      '===== EL SHIFT SYNC 完了 =====',
      `mode=${cfg.mode}`,
      `対象人数=${summary.targetMembers}`,
      `更新人数=${summary.updatedMembers}`,
      `変更セル=${summary.changedCells}`,
      `M/S保護=${summary.msProtected}`,
      `手動値保護=${summary.manualProtected}`,
      `未定義ステータス=${summary.unknownStatus}`,
      `スキップ人数=${summary.skippedMembers}`,
    ].join('\n')
  );
}



function convertStatus_(status) {
  // 海外空白
  if (!status) {
    return '休';
  }

  // 非勤務
  if (OFF_STATUS.has(status)) {
    return '休';
  }

  // 未定义
  if (!WORKING_STATUS.has(status)) {
    return null;
  }

  // 前
  if (status.startsWith('前')) {
    return '前';
  }

  // 後
  if (status.startsWith('後')) {
    return '後';
  }

  // A / R / 入社 / 大 / CX部 / TL / STL
  return '';
}


function buildMemberMap_(sheet) {
  const values =
    sheet.getDataRange().getDisplayValues();

  const result = {};

  for (let i = 1; i < values.length; i++) {
    const cwId =
      extractCwId_(
        values[i][EL_SHIFT_CONFIG.memberCwIdColumn - 1]
      ) ||
      clean_(
        values[i][EL_SHIFT_CONFIG.memberCwIdColumn - 1]
      );

    const name =
      String(
        values[i][EL_SHIFT_CONFIG.memberNameColumn - 1] || ''
      ).trim();

    if (cwId && name) {
      result[cwId] = name;
    }
  }

  return result;
}


function buildNameRowMap_(values, column) {
  const result = {};

  for (let i = 0; i < values.length; i++) {
    const name = normalize_(
      values[i][column - 1]
    );

    if (name && !result[name]) {
      result[name] = i + 1;
    }
  }

  return result;
}



function detectDateColumns_(values, minColumn, label) {
  let best = null;

  for (let r = 0; r < values.length; r++) {
    for (
      let c = minColumn - 1;
      c < values[r].length;
      c++
    ) {
      if (parseDay_(values[r][c]) !== 1) {
        continue;
      }

      let count = 0;

      for (let day = 1; day <= 31; day++) {
        const col = c + day - 1;

        if (col >= values[r].length) {
          break;
        }

        if (parseDay_(values[r][col]) !== day) {
          break;
        }

        count++;
      }

      if (!best || count > best.count) {
        best = {
          row: r + 1,
          startCol: c + 1,
          count,
        };
      }
    }
  }

  if (!best || best.count < 20) {
    throw new Error(
      `${label}表の日付行を検出できません。`
    );
  }

  Logger.log(
    `${label}日付行=` +
    `${best.row}` +
    ` / 1日=${columnLetter_(best.startCol)}` +
    ` / ${best.count}日`
  );

  const result = {};

  const year =
    EL_SHIFT_CONFIG.targetYear;

  const month =
    EL_SHIFT_CONFIG.targetMonth;

  const lastDay =
    new Date(year, month, 0).getDate();

  for (
    let day = 1;
    day <= Math.min(lastDay, best.count);
    day++
  ) {
    result[dateKey_(year, month, day)] =
      best.startCol + day - 1;
  }

  return result;
}


function parseDay_(value) {
  const text =
    String(value || '')
      .normalize('NFKC')
      .trim();

  if (!text) return null;

  // 2026/8/7
  let m =
    text.match(
      /^\d{4}[\/.-]\d{1,2}[\/.-](\d{1,2})/
    );

  if (m) {
    return Number(m[1]);
  }

  // 8/7
  m =
    text.match(
      /^\d{1,2}[\/.-](\d{1,2})/
    );

  if (m) {
    return Number(m[1]);
  }

  // 7 / 7(金) / 7（金） / 7日
  m =
    text.match(
      /^(\d{1,2})(?:日|\s|\(|（|$)/
    );

  return m
    ? Number(m[1])
    : null;
}


// ==========================================
// Target Date
// ==========================================

function getTargetDates_() {
  const year =
    EL_SHIFT_CONFIG.targetYear;

  const month =
    EL_SHIFT_CONFIG.targetMonth;

  const lastDay =
    new Date(year, month, 0).getDate();

  const result = [];

  for (let day = 1; day <= lastDay; day++) {
    result.push(
      dateKey_(year, month, day)
    );
  }

  return result;
}


function shouldProcessDate_(date) {
  const cfg = EL_SHIFT_CONFIG;

  if (
    cfg.mode === 'EXECUTE' ||
    !cfg.testDate
  ) {
    return true;
  }

  return date === normalizeDate_(cfg.testDate);
}


function shouldProcessMember_(cwId) {
  const cfg = EL_SHIFT_CONFIG;

  if (cfg.mode === 'EXECUTE') {
    return true;
  }

  if (!cfg.testCwId) {
    return true;
  }

  return String(cwId) ===
    String(cfg.testCwId);
}



function applyTargetMonth_() {
  const cfg = EL_SHIFT_CONFIG;

  if (!cfg.autoTargetMonth) {
    return;
  }

  const now = new Date();

  const date = new Date(
    now.getFullYear(),
    now.getMonth() + cfg.autoTargetMonthOffset,
    1
  );

  cfg.targetYear =
    date.getFullYear();

  cfg.targetMonth =
    date.getMonth() + 1;

  cfg.targetSheetName =
    `${cfg.targetYear}${String(
      cfg.targetMonth
    ).padStart(2, '0')}`;

  cfg.sourceSheetName =
    `${cfg.targetYear}年${cfg.targetMonth}月`;
}


function openSpreadsheet_(id) {
  return id
    ? SpreadsheetApp.openById(id)
    : SpreadsheetApp.getActiveSpreadsheet();
}


function getSheet_(ss, name) {
  const sheet =
    ss.getSheetByName(name);

  if (!sheet) {
    throw new Error(
      `シートが見つかりません: ${name}`
    );
  }

  return sheet;
}


function extractCwId_(value) {
  const text =
    String(value || '');

  const match =
    text.match(/\[To:(\d+)\]/i);

  return match
    ? match[1]
    : '';
}


function clean_(value) {
  return String(value || '')
    .normalize('NFKC')
    .replace(/\s+/g, '')
    .trim();
}


function normalize_(value) {
  return clean_(value)
    .toLowerCase();
}


function dateKey_(year, month, day) {
  return (
    `${year}-` +
    `${String(month).padStart(2, '0')}-` +
    `${String(day).padStart(2, '0')}`
  );
}


function normalizeDate_(value) {
  const m =
    String(value)
      .match(
        /^(\d{4})[-/](\d{1,2})[-/](\d{1,2})$/
      );

  if (!m) {
    return String(value);
  }

  return dateKey_(
    Number(m[1]),
    Number(m[2]),
    Number(m[3])
  );
}


function columnLetter_(column) {
  let result = '';

  while (column > 0) {
    const n =
      (column - 1) % 26;

    result =
      String.fromCharCode(65 + n) +
      result;

    column =
      Math.floor((column - 1) / 26);
  }

  return result;
}
